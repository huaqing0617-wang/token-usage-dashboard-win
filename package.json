{
  "name": "@huaqing/dsh-token-usage-dashboard",
  "version": "0.3.0",
  "private": true,
  "description": "Always-on Token usage, spend, balance, API, and model dashboard for DeepSeek Harness on Windows.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "official-browser.js",
    "pricing.js",
    "usage.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "bridge.js",
    "scripts/*.mjs",
    "edge-bridge/manifest.json",
    "edge-bridge/content.js",
    "edge-bridge/icon.svg",
    "edge-bridge/README.md",
    "edge-bridge/icon16.png",
    "edge-bridge/icon48.png",
    "edge-bridge/icon128.png",
    "LICENSE",
    ".gitignore",
    "docs/*.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/*.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huaqing0617-wang/token-usage-dashboard-win.git"
  },
  "homepage": "https://github.com/huaqing0617-wang/token-usage-dashboard-win",
  "bugs": {
    "url": "https://github.com/huaqing0617-wang/token-usage-dashboard-win/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check usage.js && node --check pricing.js && node --check bridge.js && node --check official-browser.js && node --check edge-bridge/content.js && node --check scripts/verify-official-browser.mjs",
    "test": "npm run check && node test/official-browser.test.mjs && node test/bridge.test.mjs && node test/extension-smoke.mjs && node test/client-smoke.mjs",
    "verify:windows": "node scripts/verify-official-browser.mjs",
    "verify:windows:launch": "node scripts/verify-official-browser.mjs --launch"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-usage",
    "usage-dashboard",
    "edge-extension",
    "windows",
    "microsoft-edge"
  ],
  "author": "Mingze Wang (huaqing0617-wang)"
}
